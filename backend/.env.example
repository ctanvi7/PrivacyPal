APP_HOST=127.0.0.1
APP_PORT=8000
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=25
PDF_MAX_CHARS=25000
PDF_TIMEOUT_SECONDS=15
FRONTEND_ORIGIN=http://127.0.0.1:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b
MODEL_TIMEOUT_SECONDS=120
# Keep model weights loaded between local requests to avoid repeated cold starts.
OLLAMA_KEEP_ALIVE_SECONDS=900
ANSWER_PROVIDER_NAME=Groq
ANSWER_PROVIDER_URL=https://api.groq.com/openai/v1
# Required: supply your chosen Groq model ID; no model is assumed.
ANSWER_PROVIDER_MODEL=
# Backend only. Alternatively set GROQ_API_KEY below.
ANSWER_PROVIDER_API_KEY=
GROQ_API_KEY=
ANSWER_PROVIDER_TIMEOUT_SECONDS=30
